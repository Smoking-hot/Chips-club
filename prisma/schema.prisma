generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  crisps      Crisp[]
  reviews     Review[]
  invitesSent InviteCode[] @relation("InviteCreator")

  @@map("users")
}

model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  createdById String?
  createdBy   User?     @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  usedByEmail String?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@map("invite_codes")
}

model Crisp {
  id          String   @id @default(cuid())
  name        String
  brand       String
  country     String
  // Legacy single photo, from before crisps could have several. The seed
  // script moves any value here into `photos` and clears it on each deploy.
  imageUrl    String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  reviews Review[]
  photos  CrispPhoto[]

  @@unique([name, brand])
  @@map("crisps")
}

model CrispPhoto {
  id        String   @id @default(cuid())
  crispId   String
  crisp     Crisp    @relation(fields: [crispId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())

  @@index([crispId])
  @@map("crisp_photos")
}

model Review {
  id           String   @id @default(cuid())
  crispId      String
  crisp        Crisp    @relation(fields: [crispId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating       Int
  tastingNotes String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([crispId, userId])
  @@map("reviews")
}
