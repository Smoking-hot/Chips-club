DATABASE_URL="postgresql://user:password@host:5432/database"
SESSION_SECRET="change-me-to-a-long-random-string"
# Needed for crisp photo uploads — set automatically by Vercel once a Blob
# store is connected to the project; for local dev, copy it from
# Vercel Storage → your Blob store → .env.local tab.
BLOB_READ_WRITE_TOKEN=""

# Comma-separated list of emails to grant admin (edit/delete crisps) on every
# deploy's seed step. A listed email with no matching account yet is skipped
# until that person registers. Optional — leave unset for no admins.
ADMIN_EMAILS=""
